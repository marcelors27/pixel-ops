{
  "display": {
    "width": 320,
    "height": 480,
    "device": {
      "target": "window",
      "output": "window",
      "window_scale": 2,
      "seconds": 20,
      "forever": true,
      "preview_sequence": false,
      "full_frame": false
    },
    "layout": {
      "timezones": {
        "x": 0,
        "y": 0,
        "width": 318,
        "height": 136
      },
      "route_signal": {
        "x": 0,
        "y": 172,
        "width": 185,
        "height": 39
      },
      "gauges": {
        "x": 185,
        "y": 172,
        "width": 131,
        "height": 40
      },
      "weather": {
        "x": 194,
        "y": 216,
        "width": 120,
        "height": 40
      },
      "activity": {
        "x": 0,
        "y": 137,
        "width": 316,
        "height": 35
      },
      "game": {
        "x": 0,
        "y": 211,
        "width": 320,
        "height": 172
      },
      "text_box": {
        "x": 0,
        "y": 385,
        "width": 320,
        "height": 92
      }
    },
    "backend": "usb_bulk_rev_a",
    "fps": 12,
    "preview_output": "pixel_ops/output/preview.png",
    "gif_output": "pixel_ops/output/preview.gif",
    "scanlines": false,
    "timezone_primary": "America/Sao_Paulo",
    "ai": {
      "enabled": true,
      "provider": "openai_chatgpt",
      "model": "gpt-5-mini",
      "reasoning_effort": "low",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_seconds": 8,
      "cache_enabled": true,
      "cache_dir": "pixel_ops/cache/ai_decisions"
    },
    "splash": {
      "enabled": true,
      "seconds": 2,
      "logo_path": "pixel_ops/assets/logo/pixel_ops_gaco_logo.jpg",
      "background": [
        8,
        10,
        18
      ]
    }
  }
}
