# Slack ambient social observability via Socket Mode
PIXEL_OPS_SLACK_ENABLED=false
PIXEL_OPS_SLACK_APP_TOKEN=
PIXEL_OPS_SLACK_BOT_TOKEN=
PIXEL_OPS_SLACK_BOT_USER_ID=
PIXEL_OPS_SLACK_SOCKET_RECONNECT_SECONDS=10

# Discord ambient social observability
PIXEL_OPS_DISCORD_ENABLED=false

# GitHub ambient integration
PIXEL_OPS_GITHUB_ENABLED=false
PIXEL_OPS_GITHUB_TOKEN=
PIXEL_OPS_GITHUB_REPOS=
PIXEL_OPS_GITHUB_POLL_SECONDS=300
PIXEL_OPS_GITHUB_MAX_PRS=4

# Google Calendar via private ICS URL
PIXEL_OPS_GOOGLE_CALENDAR_ENABLED=false
PIXEL_OPS_GOOGLE_CALENDAR_ICS_URL=
PIXEL_OPS_GOOGLE_CALENDAR_POLL_SECONDS=300

# Local ICS calendar files
PIXEL_OPS_ICS_ENABLED=false
PIXEL_OPS_ICS_PATH=
PIXEL_OPS_ICS_POLL_SECONDS=300

# Shared social event queue
PIXEL_OPS_SOCIAL_BUS_LIMIT=128

# Optional AI provider, only needed when display.ai.enabled and ai_selector.enabled are true.
# Slack/Discord are skipped by the default AI throttle in the visual plugin config.
OPENAI_API_KEY=
